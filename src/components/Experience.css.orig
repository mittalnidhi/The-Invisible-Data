	background-size: cover;

	pointer-events: all;
	transition: filter 100ms;
}

.experience__canvas.canvas-blur {
	filter: blur(10px)
}

.experience__scrollSpace {
	z-index: 0;
}

.focus-x {
	position: absolute;
	width: 36px;
	height: 36px;
	right: calc(0% - 18px);
	top: -18px;
	font-size: 20pt;
	text-align: center;
	line-height: 32px;
	background-color: white;
	color: #888;
	border-radius: 18px;
	filter: drop-shadow(0px 2px 1px #555);
	transition: color 150ms;
}

.focus-x:hover {
	color: crimson;
}

#story-focus {
	background-color: white;
	padding: 15px 18px;
	border-radius: 10px;
}

#input-story {
	background-color: #defa;
	font-size: 12pt;
	padding: 15px;
	font-family: 'Fragment Mono', Courier, monospace;
	font-weight: 400;
	border: 1px solid #0000;
	border-radius: 10px;
	scrollbar-color: white #fff0;
	pointer-events: auto;
}

#input-story:focus {
	outline: none;
	border: 1px solid gray;
}

#exp-viewer {
	background-color: #fffa;
	pointer-events: none;
	opacity: 0;
	transition: opacity 100ms;
}

.story {
	background-color: white;
	border: 7px solid white;
	border-radius: 7px;
	cursor: pointer;
	filter: drop-shadow(0px 2px 2px #555);
}

#story-submit {
	font-size: 20pt;
	border-radius: 10px;
	background-color: dodgerblue;
	color: white;
	transition: background-color 100ms;
}

#story-submit:hover {
	background-color: rgb(30, 176, 255);
}

/* Scroll tooltip */

.experience-scroll-hint {
  position: fixed;
  bottom: 35px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;

  color: #ffffff;
  font-family: "Cascadia Code", "Courier New", monospace;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;

  pointer-events: none;
  opacity: 1;
  transition: opacity 0.5s ease;
}

.experience-scroll-hint--hidden {
  opacity: 0;
}

.experience-scroll-arrow {
  font-size: 26px;
  animation: scrollBounce 1.8s ease-in-out infinite;
}

@keyframes scrollBounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(8px);
  }
}

@media (max-width: 600px) {
  .experience-scroll-hint {
    bottom: 22px;
    font-size: 10px;
  }

  .experience-scroll-arrow {
    font-size: 22px;
  }
}